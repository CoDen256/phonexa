# phonexa's own .env — read by `docker compose` in this directory, and by
# tun's `include:` of this repo's docker-compose.yml.

# Postgres password for phonexa-postgres (user `phonexa`, db `phonexa`).
# Used by the database, the backend's DATABASE_URL, and tun's backup service —
# set the SAME value as PHONEXA_POSTGRES_PASSWORD in tun/.env; nothing syncs
# them. Must be URL-safe (no @ : / ? # %) since it is embedded in DATABASE_URL.
# Must be set before the first boot: Postgres only reads it when it creates
# the volume.
PHONEXA_POSTGRES_PASSWORD=phonexa

# Shadowing's transcription is proxied to smia's POST /stt (no local model).
# SMIA_BASE_URL: where smia is reachable FROM the phonexa-backend container —
#   the default works under tun (service `smia-backend` on tun-shared).
# SMIA_AUTH_TOKEN: smia's shared bearer token (SMIA_AUTH_TOKEN in smia's own
#   .env). Server-side only. Leave empty to disable transcription.
# SMIA_BASE_URL=http://smia-backend:5055
SMIA_AUTH_TOKEN=
